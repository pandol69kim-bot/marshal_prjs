# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/appdb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=your-very-long-secret-key-at-least-256-bits-long-replace-this

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# App
ALLOWED_ORIGINS=http://localhost:5173
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=uploads
S3_REGION=ap-northeast-2

# External APIs
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@example.com
NCP_SMS_ACCESS_KEY=your-ncp-access-key
NCP_SMS_SECRET_KEY=your-ncp-secret-key
NCP_SMS_SERVICE_ID=your-service-id
NCP_SMS_SENDER_PHONE=01000000000

# External Data API
EXTERNAL_DATA_API_BASE_URL=https://api.example.com
EXTERNAL_DATA_API_KEY=your-api-key
